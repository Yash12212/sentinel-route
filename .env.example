MLFLOW_TRACKING_URI=http://localhost:5000  # Tracking server and registry.
MIN_PROMOTION_F1=0.85  # Reject candidates below this hold-out F1.
CASCADE_LOW=0.20  # Trust the fast tier at or below this probability.
CASCADE_HIGH=0.80  # Trust the fast tier at or above this probability.
DB_PATH=logs/predictions.db  # SQLite prediction log.
EVAL_REPORT_PATH=data/eval_report.json  # Generated evidence pack.
POLL_INTERVAL_SEC=5  # Watchdog poll cadence.
ANOMALY_STREAK_LIMIT=3  # Consecutive anomalies before healing.
HEAL_COOLDOWN_SEC=30  # Pause between healing actions.
MIN_DRIFT_SAMPLES=50  # Minimum live rows for a drift test.
TARGET_BASE=http://localhost:8001  # Watchdog victim service.
API_BASE=http://localhost:8000  # API base for predict and reload.
HEAL_RESTART_CMD=docker compose restart target-service  # Restart command for the target.
