# Tracking server and registry.
MLFLOW_TRACKING_URI=http://localhost:5000

# Reject candidates below this hold-out F1.
MIN_PROMOTION_F1=0.85

# Trust the fast tier at or below this probability.
CASCADE_LOW=0.20

# Trust the fast tier at or above this probability.
CASCADE_HIGH=0.80

# SQLite prediction log.
DB_PATH=logs/predictions.db

# Generated evidence pack.
EVAL_REPORT_PATH=data/eval_report.json

# Watchdog poll cadence.
POLL_INTERVAL_SEC=5

# Consecutive anomalies before healing.
ANOMALY_STREAK_LIMIT=3

# Pause between healing actions.
HEAL_COOLDOWN_SEC=30

# Minimum live rows for a drift test.
MIN_DRIFT_SAMPLES=50

# Watchdog victim service.
TARGET_BASE=http://localhost:8001

# API base for predict and reload.
API_BASE=http://localhost:8000

# Restart command for the target.
HEAL_RESTART_CMD="docker compose restart target-service"
